<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ff_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/filefinity_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/filefinity_logo" />

        <TextView
            android:id="@+id/ff_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Filefinity"
            android:textColor="#9AA39C"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout style="@style/FfCell">
            <TextView android:id="@+id/ff_posts" style="@style/FfValue" />
            <TextView style="@style/FfLabel" android:text="Posts" />
        </LinearLayout>

        <LinearLayout style="@style/FfCell">
            <TextView android:id="@+id/ff_downloads" style="@style/FfValue" />
            <TextView style="@style/FfLabel" android:text="Downloads" />
        </LinearLayout>

        <LinearLayout style="@style/FfCell">
            <TextView android:id="@+id/ff_users" style="@style/FfValue" />
            <TextView style="@style/FfLabel" android:text="Users" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
